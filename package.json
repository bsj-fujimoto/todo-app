{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal ToDo app (frontend/backend/docker compose) and an exemplar QA/QC deliverable set",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "backend",
    "frontend",
    "e2e"
  ],
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e --workspace e2e",
    "e2e:compose": "npm run e2e:compose --workspace e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "yaml": "2.9.1"
  }
}
